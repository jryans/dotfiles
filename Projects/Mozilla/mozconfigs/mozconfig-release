# objdir
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-firefox-release

# Make Options
# mk_add_options AUTOCONF=autoconf213

# Application
ac_add_options --enable-application=browser

# NixOS
# Precompiled tools won't work on NixOS
ac_add_options --disable-bootstrap
ac_add_options --with-libclang-path=/nix/store/bljp5s9sb7kz2yfz4g1mix0g7n00lpdv-clang-21.1.7-lib/lib
ac_add_options --without-wasm-sandboxed-libraries
export AS="/nix/store/3g9wh4yb0k74sz2rclz6vvf9m7l3f8ii-clang-wrapper-21.1.7/bin/clang"

# Features
ac_add_options --disable-crashreporter
ac_add_options --enable-debug-js-modules
# ac_add_options --with-l10n-base=@TOPSRCDIR@/../l10n

# Compiling and Debugging
ac_add_options --disable-debug
if test "${MOZ_ARTIFACT}" != "1"; then
  # ac_add_options --enable-rust-debug
  # ac_add_options --enable-warnings-as-errors
  ac_add_options --with-ccache=sccache
  # ac_add_options --enable-logrefcnt
fi

# Linking
if test "${MOZ_ARTIFACT}" != "1"; then
  ac_add_options --disable-strip
  ac_add_options --disable-install-strip
fi

# Testing
# (none)
